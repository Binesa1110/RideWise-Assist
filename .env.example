# Copy this file to .env and replace placeholders with current event-provided values.
# Never put a real API key in .env.example or commit .env to Git.

# Based on the organiser's OpenAI-compatible example.
# You may set this to the base URL ending in /openai/v1
# OR the full URL ending in /chat/completions.
NEOSTATS_API_URL=https://neo-hackathon.services.ai.azure.com/openai/v1/
# Alternative supported variable name: NEOSTATS_BASE_URL
# NEOSTATS_BASE_URL=https://neo-hackathon.services.ai.azure.com/openai/v1/

NEOSTATS_API_KEY=replace-with-current-event-key
NEOSTATS_MODEL=Neo-Hackathon
NEOSTATS_TIMEOUT=30

RIDEWISE_DB_PATH=./data/ridewise_dev.db
RIDEWISE_POLICY_DIR=./policies
